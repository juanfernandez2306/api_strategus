{% extends "Layouts/BaseEmail.html.twig" %}

{% block title %}Restablecer Contraseña{% endblock %}

{% block greeting %}¡Hola, {{ userFullName }}!{% endblock %}

{% block content %}
    <p style="font-size: 16px; line-height: 1.5; color: #222222;">
        Has solicitado restablecer tu contraseña en <strong>GESTIÓN DE PALMA DIGITAL</strong>.
    </p>
    <p style="font-size: 16px; line-height: 1.5; color: #222222;">
        Para continuar con el proceso y asignar una nueva clave, por favor haz clic en el siguiente botón:
    </p>
    
    <div style="text-align: center; margin: 35px 0;">
        <a href="{{ actionUrl }}" style="background-color: #386641; color: #ffffff; padding: 14px 30px; text-decoration: none; border-radius: 4px; display: inline-block; font-weight: bold; font-size: 16px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
            Restablecer Contraseña
        </a>
    </div>
    
    <p style="font-size: 14px; line-height: 1.5; color: #555555;">
        Si no solicitaste este cambio, puedes ignorar este mensaje de forma segura; tu contraseña actual no sufrirá ningún cambio.
    </p>

    <p style="color: #666666; font-size: 13px; text-align: center; margin-top: 25px; margin-bottom: 25px;">
        Este enlace de recuperación expirará en 12 horas.
    </p>
{% endblock %}