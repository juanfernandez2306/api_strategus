{% extends "Layouts/BaseEmail.html.twig" %}

{% block title %}Verificar Correo{% endblock %}

{% block greeting %}¡Hola, {{ userFullName }}!{% endblock %}

{% block content %}
    <p style="font-size: 16px; line-height: 1.5; color: #222222;">
        Gracias por registrarte en <strong>GESTIÓN DE PALMA DIGITAL</strong>.
    </p>
    <p style="font-size: 16px; line-height: 1.5; color: #222222;">
        Para activar por completo tu cuenta de usuario, por favor confirma tu dirección de correo haciendo clic en el siguiente botón:
    </p>
    
    <div style="text-align: center; margin: 35px 0;">
        <a href="{{ actionUrl }}" style="background-color: #386641; color: #ffffff; padding: 14px 30px; text-decoration: none; border-radius: 4px; display: inline-block; font-weight: bold; font-size: 16px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
            Verificar mi Correo
        </a>
    </div>
    
    <p style="color: #666666; font-size: 13px; text-align: center; margin-bottom: 25px;">
        Este enlace de confirmación expirará en 12 horas.
    </p>
{% endblock %}