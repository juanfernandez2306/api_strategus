<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}GEOLOCALIZACIÓN - GESTIÓN PALMA DIGITAL{% endblock %}</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif; margin: 0; padding: 40px 20px; background-color: #cbcbcb; color: #222222;">
    <div style="max-width: 600px; margin: 0 auto; padding: 30px; border-radius: 8px; background-color: #ffffff; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);">
        
        {% if logoUrl %}
        <div style="text-align: center; margin-bottom: 25px;">
            <img src="{{ logoUrl }}" alt="GESTIÓN PALMA DIGITAL" style="max-width: 180px; height: auto; display: inline-block;">
        </div>
        {% endif %}

        <h2 style="color: #222222; margin-top: 0; font-size: 24px;">{% block greeting %}¡Hola!{% endblock %}</h2>
        
        {% block content %}{% endblock %}

        <hr style="border: 0; border-top: 1px solid #DFDFDE; margin: 20px 0;">
        
        <p style="color: #999999; font-size: 11px; text-align: center; line-height: 1.4; margin: 0;">
            Si tú no solicitaste este mensaje, puedes ignorarlo de forma segura.
        </p>
    </div>
</body>
</html>